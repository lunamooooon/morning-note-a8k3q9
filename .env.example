# Copy this file to .env and fill in your own values.

# Required when using: python3 digest.py --send
PUSHPLUS_TOKEN=

# Optional. Defaults to wechat.
PUSHPLUS_CHANNEL=wechat

# Optional. Use this if you send to a pushplus group topic.
PUSHPLUS_TOPIC=

# Optional. Enables Tushare as an additional news source when the tushare package is installed.
TUSHARE_TOKEN=
